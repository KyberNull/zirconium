# Normalize line endings to LF in the repository and in working trees.
* text=auto eol=lf

# Prevent GitHub from displaying comments within JSON files as errors.
*.json linguist-language=JSON-with-Comments

# Binary assets must never be touched by line-ending conversion.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.wav binary
*.provisionprofile binary
